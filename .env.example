# API base URL for the Gravity REST API (gravity-service)
# Required for production builds.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Show demo role shortcuts on the login page (default: on in dev, off in production).
# NEXT_PUBLIC_ENABLE_DEMO=true

# Live Playwright suite (requires gravity-service on NEXT_PUBLIC_API_URL with local profile seed).
# For GitHub Actions live e2e, add a GRAVITY_SERVICE_CHECKOUT_TOKEN secret with read access
# to pprike/gravity-service. Without it, the live job skips instead of failing the PR.
# E2E_LIVE=true
# E2E_ADMIN_EMAIL=admin@tenant-a.com
# E2E_ADMIN_PASSWORD=Password123!
